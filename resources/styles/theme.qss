#AppRoot {
    border-image: url(:/surfaces/background.png) 0 0 0 0 stretch stretch;
}

/* ----- Status bar ----- */
#statusClock {
    color: @text;
    font-size: @font-small;
    font-weight: bold;
}

#statusClock[synced="false"] {
    color: @text-muted;
}

#systemCheckChip {
    background-color: @warn;
    color: @on-warn;
    border-radius: @radius-chip;
    font-size: @font-caption;
    font-weight: bold;
    padding: 2px 7px;
}

/* ----- Thanh tab ----- */
BottomNavBar {
    border-image: url(:/surfaces/nav.png) 0 0 0 0 stretch stretch;
}

/* ----- Trang con ----- */
#subPageTitle {
    color: @text;
    font-size: @font-title;
    font-weight: bold;
}

#backButton {
    border: none;
    border-image: url(:/surfaces/back.png) 0 0 0 0 stretch stretch;
    padding: 0 0 2px 2px;
}

#backButton:pressed {
    border-image: url(:/surfaces/back_pressed.png) 0 0 0 0 stretch stretch;
    padding: 0 0 0 2px;
}

RaisedButton {
    border-width: 4px 16px 7px 16px;
    padding: 0 -10px;
    color: @text;
    font-size: @font-body;
    font-weight: bold;
}

RaisedButton:focus {
    outline: none;
}

RaisedButton[variant="primary"] {
    border-image: url(:/surfaces/btn_primary.png) 4 16 7 16 repeat stretch;
    color: @on-primary;
}

RaisedButton[variant="primary"]:pressed {
    border-image: url(:/surfaces/btn_primary_pressed.png) 4 16 7 16 repeat stretch;
    padding: 2px -10px 0 -10px;
}

RaisedButton[variant="secondary"] {
    border-image: url(:/surfaces/btn_secondary.png) 4 16 7 16 repeat stretch;
}

RaisedButton[variant="secondary"]:pressed {
    border-image: url(:/surfaces/btn_secondary_pressed.png) 4 16 7 16 repeat stretch;
    padding: 2px -10px 0 -10px;
}

RaisedButton[variant="danger"] {
    border-image: url(:/surfaces/btn_danger.png) 4 16 7 16 repeat stretch;
    color: @on-danger;
}

RaisedButton[variant="danger"]:pressed {
    border-image: url(:/surfaces/btn_danger_pressed.png) 4 16 7 16 repeat stretch;
    padding: 2px -10px 0 -10px;
}

RaisedButton[variant]:disabled {
    border-image: url(:/surfaces/btn_disabled.png) 4 16 7 16 repeat stretch;
    color: @text-muted;
}

/* ----- Thẻ đại lượng ở S1 ----- */
MetricTile[metric="temperature"] {
    border-image: url(:/surfaces/tile_temp.png) 0 0 0 0 stretch stretch;
}

MetricTile[metric="humidity"] {
    border-image: url(:/surfaces/tile_humi.png) 0 0 0 0 stretch stretch;
}

MetricTile[metric="light"] {
    border-image: url(:/surfaces/tile_light.png) 0 0 0 0 stretch stretch;
}

MetricTile[dead="true"] {
    border-width: 16px 18px 19px 18px;
    border-image: url(:/surfaces/card.png) 16 18 19 18 repeat stretch;
}

/* ----- Biểu đồ S2 ----- */
#metricTabLine {
    background-color: @divider;
}

QPushButton[metricTab] {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: @text-muted;
    font-size: @font-small;
}

QPushButton[metricTab]:checked {
    color: @text;
    font-weight: bold;
}

QPushButton[metricTab="temperature"]:checked {
    border-bottom-color: @chart-temp;
}

QPushButton[metricTab="humidity"]:checked {
    border-bottom-color: @chart-humi;
}

QPushButton[metricTab="light"]:checked {
    border-bottom-color: @chart-light;
}

ChartCanvas {
    background: transparent;
    border: none;
}

#statCaption {
    color: @text-muted;
    font-size: @font-caption;
}

#statValue {
    color: @text;
    font-size: @font-stat;
    font-weight: bold;
}

/* ----- Thẻ ----- */
QFrame[surface="card"] {
    border-width: 16px 18px 19px 18px;
    border-image: url(:/surfaces/card.png) 16 18 19 18 repeat stretch;
}

/* ----- Nút chọn dạng segment ----- */
QWidget[surface="segTrack"] {
    border-width: 0 10px;
    border-image: url(:/surfaces/seg_track.png) 0 10 0 10 repeat stretch;
}

QPushButton[segment="true"] {
    background: transparent;
    border: none;
    color: @text-muted;
    font-size: @font-small;
}

QPushButton[segment="true"]:checked {
    border-width: 0 8px;
    padding: 0 -7px;
    border-image: url(:/surfaces/seg_on.png) 0 8 0 8 repeat stretch;
    color: @on-primary;
    font-weight: bold;
}

QWidget[surface="miniTrack"] {
    border-width: 0 7px;
    border-image: url(:/surfaces/mini_track.png) 0 7 0 7 repeat stretch;
}

QPushButton[miniSegment] {
    background: transparent;
    border: none;
    color: @text-muted;
    font-size: @font-small;
}

/* Nút cao 40 px để đủ vùng chạm, margin thu phần hiển thị về ô 32×28. */
QPushButton[miniSegment="left"] {
    margin: 6px 0 6px 12px;
}

QPushButton[miniSegment="right"] {
    margin: 6px 10px 6px 0;
}

QPushButton[miniSegment]:checked {
    border-width: 0 5px;
    border-image: url(:/surfaces/mini_on.png) 0 5 0 5 repeat stretch;
    color: @on-primary;
    font-weight: bold;
}

/* ----- Toggle ----- */
QCheckBox[toggle="true"]::indicator {
    width: 44px;
    height: 26px;
    image: url(:/surfaces/toggle_off.png);
}

QCheckBox[toggle="true"]::indicator:checked {
    image: url(:/surfaces/toggle_on.png);
}

/* ----- Slider ----- */
QSlider::groove:horizontal {
    height: 8px;
    margin: 0 12px;
    border-width: 0 4px;
    border-image: url(:/surfaces/slider_track.png) 0 4 0 4 repeat stretch;
}

QSlider::sub-page:horizontal {
    height: 8px;
    margin: 0 0 0 12px;
    border-width: 0 4px;
    border-image: url(:/surfaces/slider_fill.png) 0 4 0 4 repeat stretch;
}

QSlider::handle:horizontal {
    width: 32px;
    height: 32px;
    margin: -12px -16px;
    image: url(:/surfaces/slider_knob.png);
}

/* ----- Trang con ----- */
#fieldCaption,
#sectionLabel {
    color: @text-muted;
    font-size: @font-small;
}

#bigValue {
    color: @primary;
    font-size: @font-value-big;
    font-weight: bold;
}

#fieldTitle {
    color: @text;
    font-size: @font-body;
    font-weight: bold;
}

#fieldNote {
    color: @text-muted;
    font-size: @font-caption;
}

#inlineError {
    color: @error;
    font-size: @font-small;
}

#locationList {
    background-color: @card-top;
}

#scrollIndicator {
    background-color: @text-muted;
    border-radius: 1px;
}

QScrollArea#locationScroll {
    background: transparent;
    border: none;
}
